<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- EKRAN 1: MENU GŁÓWNE -->
    <LinearLayout
        android:id="@+id/layoutMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Park"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="48dp"/>

        <Button
            android:id="@+id/btnMenuSave"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ZAPISZ MIEJSCE PARKOWANIA"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnMenuNavigate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PROWADŹ DO AUTA"/>

        <Button
            android:id="@+id/btnSetTicket"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="⏰ PRZYPOMNIJ O BILECIE (TEST 1 MIN)"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <!-- EKRAN 2: ZAPISYWANIE POZYCJI -->
    <LinearLayout
        android:id="@+id/layoutSave"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStatusSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Czekam na sygnał GPS..."
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <ImageView
            android:id="@+id/ivParkedCar"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📷 ZRÓB ZDJĘCIE OTOCZENIA"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnBackFromSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="POWRÓT DO MENU"/>
    </LinearLayout>

    <!-- EKRAN 3: KOMPAS (NAWIGACJA) -->
    <LinearLayout
        android:id="@+id/layoutNavigate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kieruj się w stronę strzałki:"
            android:textSize="18sp"
            android:textAlignment="center"/>

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Odległość: 0 m"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬆"
            android:textSize="120sp"
            android:layout_marginTop="16dp"/>

        <ImageView
            android:id="@+id/ivNavParkedCar"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnBackFromNavigate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="ZAKOŃCZ I WRÓĆ DO MENU"
            android:layout_marginTop="32dp"/>
    </LinearLayout>

    <!-- EKRAN 4: NAKŁADKA PEŁNOEKRANOWA ZDJĘCIA -->
    <FrameLayout
        android:id="@+id/layoutFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivFullscreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/btnCloseFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZAMKNIJ"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"/>
    </FrameLayout>

</FrameLayout>