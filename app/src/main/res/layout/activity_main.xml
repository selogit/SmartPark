<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- EKRAN 1: MENU GŁÓWNE -->
    <LinearLayout
        android:id="@+id/layoutMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Park"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="48dp"/>

        <Button
            android:id="@+id/btnMenuSave"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ZAPISZ MIEJSCE PARKOWANIA"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnMenuNavigate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="HISTORIA PARKOWAŃ"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnSetTicket"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="⏰ PILNUJ BILETU"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnToggleTheme"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🌓 ZMIEŃ MOTYW"/>
    </LinearLayout>

    <!-- EKRAN 2: ZAPISYWANIE POZYCJI -->
    <LinearLayout
        android:id="@+id/layoutSave"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStatusSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Czekam na sygnał GPS..."
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <ImageView
            android:id="@+id/ivParkedCar"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📷 ZRÓB ZDJĘCIE OTOCZENIA"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnAddNote"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📝 DODAJ NOTATKĘ (NP. PIĘTRO)"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnBackFromSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="POWRÓT DO MENU"/>
    </LinearLayout>

    <!-- EKRAN 3: KOMPAS I SZCZEGÓŁY (NAWIGACJA) -->
    <RelativeLayout
        android:id="@+id/layoutNavigate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- ScrollView zapobiega ucinaniu elementów na małych ekranach -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:paddingBottom="100dp"> <!-- Dodatkowy margines na dole, żeby przewinąć pod przyciskiem udostępniania -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kieruj się w stronę strzałki:"
                    android:textSize="18sp"
                    android:textAlignment="center"/>

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Odległość: 0 m"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/tvNavNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notatka"
                    android:textSize="18sp"
                    android:textStyle="italic"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬆"
                    android:textSize="100sp"
                    android:layout_marginTop="8dp"/>

                <!-- Zaokrąglone zdjęcie -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNavParkedCar"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivNavParkedCar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Wbudowana mapa -->
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/mapFragment"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Przycisk zewn. aplikacji (który chciałeś zostawić) -->
                <Button
                    android:id="@+id/btnOpenGoogleMaps"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="🗺️ OTWÓRZ W APLIKACJI MAPY"
                    android:layout_marginTop="8dp"/>

                <!-- Przycisk powrotu -->
                <Button
                    android:id="@+id/btnBackFromNavigate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="ZAKOŃCZ I WRÓĆ DO MENU"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
        </ScrollView>

        <!-- NOWOCZESNY LEWITUJĄCY PRZYCISK (FAB) DO UDOSTĘPNIANIA W PRAWYM GÓRNYM ROGU -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="24dp"
            android:src="@android:drawable/ic_menu_share"
            app:tint="@android:color/white"
            android:contentDescription="Udostępnij lokalizację"/>
    </RelativeLayout>

    <!-- EKRAN 4: NAKŁADKA PEŁNOEKRANOWA ZDJĘCIA -->
    <FrameLayout
        android:id="@+id/layoutFullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivFullscreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/btnCloseFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZAMKNIJ"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"/>
    </FrameLayout>

    <!-- EKRAN 5: HISTORIA -->
    <LinearLayout
        android:id="@+id/layoutHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historia Parkowań"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textAlignment="center"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🗑️ WYCZYŚĆ CAŁĄ HISTORIĘ"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnBackFromHistory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="POWRÓT DO MENU"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

</FrameLayout>